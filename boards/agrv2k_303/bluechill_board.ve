# LCD control GPIO
GPIO4_5 PIN_41 # LCD_RES
GPIO4_6 PIN_42 # LCD_DC
# GPIO5_0 PIN_43 # LCD_CS
GPIO5_1 PIN_45 # LCD_BLK

# Keys - GPIO input
GPIO3_1 PIN_26 # KEY1
GPIO3_2 PIN_27 # KEY2
GPIO3_3 PIN_28 # KEY3
GPIO4_3 PIN_39 # KEYB
GPIO4_4 PIN_40 # KEYA
GPIO5_2 PIN_46 # KEYD

# UART0 - debug
UART0_UARTRXD PIN_31
UART0_UARTTXD PIN_30
