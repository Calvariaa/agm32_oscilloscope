SYSCLK 200
BUSCLK 100

HSECLK 8

# LED
GPIO0_0 PIN_2

# SPI1 - ST7789 LCD
SPI1_SCK    PIN_15
SPI1_SI_IO0 PIN_17 # MOSI
SPI1_CSN    PIN_43

# Timer - PWM output (TIM2_CH3 equivalent)
